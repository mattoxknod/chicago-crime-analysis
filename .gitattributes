# This repository is developed on Windows, where Git's autocrlf would otherwise
# check shell scripts out with CRLF endings. A CRLF shebang line makes a script
# unrunnable on Linux and macOS ("bad interpreter"), so the scripts anyone
# reproducing this would actually run are pinned to LF.
*.sh text eol=lf
*.sql text eol=lf

# Keep the web files consistent too, so diffs stay readable.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

*.geojson binary
